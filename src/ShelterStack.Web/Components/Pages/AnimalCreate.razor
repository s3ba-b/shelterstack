@page "/animals/new"
@inject GatewayClient Gateway
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["AnimalForm_Create_Title"] · ShelterStack</PageTitle>

<div class="page-head">
    <div>
        <h1>@L["AnimalForm_Create_Title"]</h1>
        <p>@L["AnimalForm_Create_Subtitle"]</p>
    </div>
</div>

<AnimalForm Model="_model"
            SubmitLabel="@L["AnimalForm_Create_Submit"].Value"
            CancelHref="animals"
            Busy="_busy"
            ServerError="@_error"
            OnValidSubmit="SaveAsync" />

@code {
    private readonly AnimalFormModel _model = new();
    private bool _busy;
    private string? _error;

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;

        using var response = await Gateway.SendJsonAsync(
            HttpMethod.Post,
            "/animals",
            _model.ToRequest(),
            CancellationToken.None
        );

        if (response.IsSuccessStatusCode)
        {
            var created = await response.Content.ReadFromJsonAsync<AnimalResponse>(
                GatewayJson.Options,
                CancellationToken.None
            );
            Navigation.NavigateTo(created is null ? "animals" : $"animals/{created.Id}");
            return;
        }

        _error = response.StatusCode switch
        {
            System.Net.HttpStatusCode.Forbidden => L["AnimalForm_Error_Forbidden"],
            _ => L["AnimalForm_Error_Generic"],
        };
        _busy = false;
    }
}
