@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedStrings> L
@inject IJSRuntime JS
@inject WebAuthenticationStateProvider Auth

@* Route guard: every page wrapped by this layout requires a signed-in session. An
   unauthenticated visitor is redirected to sign-in (with a return URL) and the shell is not
   rendered. The sign-in page deliberately uses the chromeless EmptyLayout, so it is exempt. *@
@if (_authenticated)
{
<div class="grid min-h-screen grid-cols-1 min-[861px]:grid-cols-[244px_1fr]">
    <NavMenu />

    <div class="flex min-w-0 flex-col">
        <header class="sticky top-0 z-20 flex h-[60px] items-center gap-4 border-b border-border bg-[rgba(255,255,255,0.82)] px-6 backdrop-blur-[10px]">
            <div class="flex items-center gap-2 text-[0.86rem] text-muted">
                <b class="font-semibold text-text">@CurrentPageTitle</b>
            </div>
            <div class="ml-auto flex w-[280px] items-center gap-2 rounded-full border border-border bg-surface-2 px-3.5 py-[7px] text-muted max-[860px]:hidden">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                <input class="w-full border-none bg-transparent text-[0.86rem] text-text outline-none" placeholder="@L["Shell_SearchPlaceholder"]" disabled />
            </div>
            <button class="grid h-9 w-9 place-items-center rounded-[9px] border border-border bg-surface text-text-2 transition hover:bg-surface-2" disabled aria-label="Notifications">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /></svg>
            </button>
            <LanguageToggle />
        </header>

        <main class="mx-auto w-full max-w-[1280px] px-8 pt-7 pb-20">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool _authenticated;
    // True once OnAfterRenderAsync has run and we've had a chance to restore from sessionStorage.
    // Until then we suppress the redirect so a language-toggle reload doesn't lose the session.
    private bool _sessionChecked;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is null)
            return;

        var user = (await AuthState).User;
        _authenticated = user.Identity?.IsAuthenticated == true;

        if (!_authenticated && _sessionChecked)
        {
            RedirectToLogin();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _sessionChecked = true;

        if (_authenticated)
            return;

        // The circuit is fresh (e.g. after a language-toggle forceLoad reload). Try to restore
        // the token that Login.razor saved to sessionStorage before the reload.
        var session = await JS.InvokeAsync<SessionInfo?>("languageInterop.getSession");
        if (session?.Token is not null && session.Email is not null)
        {
            Auth.SignIn(session.Token, session.Email);
            // NotifyAuthenticationStateChanged triggers OnParametersSetAsync again with the
            // restored user, so the shell renders without a redirect.
        }
        else
        {
            RedirectToLogin();
        }
    }

    private void RedirectToLogin()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        var target = string.IsNullOrEmpty(returnUrl)
            ? "login"
            : $"login?returnUrl={Uri.EscapeDataString(returnUrl)}";
        Navigation.NavigateTo(target, replace: true);
    }

    private string CurrentPageTitle
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
            // "animals", "animals/new", "animals/{id}", "animals/{id}/edit" all sit under Animals.
            return path == "animals" || path.StartsWith("animals/", StringComparison.Ordinal)
                ? L["Shell_PageTitle_Animals"]
                : L["Shell_PageTitle_Overview"];
        }
    }

    private sealed class SessionInfo
    {
        public string? Token { get; set; }
        public string? Email { get; set; }
    }
}
