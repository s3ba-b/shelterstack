<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Aspire.Npgsql gives connection-string resolution + a health check for the
      "identitydb" resource. Npgsql.EntityFrameworkCore.PostgreSQL is added directly
      (not the Aspire.Npgsql.EntityFrameworkCore.PostgreSQL wrapper) because that wrapper's
      AddNpgsqlDbContext always pools contexts via AddDbContextPool, and a pooled context
      with a constructor-injected scoped ITenantContext would let one request's tenant
      leak into a reused context from a later request. AddDbContext below is unpooled,
      so EF Core resolves ITenantContext from the correct per-request scope every time.
    -->
    <PackageReference Include="Aspire.Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!--
      Referenced explicitly, though the Npgsql provider already brings them in transitively:
      the provider's EF dependency is a range whose floor (10.0.4) is older than the version
      the test projects resolve, which produced the MSB3277 conflicts of #107. See the EF Core
      group in Directory.Packages.props.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Mints/signs the JWT access tokens the login endpoint returns (JwtTokenIssuer). -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShelterStack.ServiceDefaults\ShelterStack.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
