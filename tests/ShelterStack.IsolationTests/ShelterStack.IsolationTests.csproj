<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Real HTTP host (WebApplicationFactory) over a real Postgres (Testcontainers), not a
      bare DbContext: per CHARTER.md's cross-tenant risk mitigation, a regression where
      AnimalsDbContext is registered pooled (AddDbContextPool) instead of scoped
      (AddDbContext) would leak one request's resolved tenant into another request's reused
      pooled instance — and a test that constructs the DbContext directly, bypassing
      Program.cs's actual DI registration, would never exercise that and could never catch it.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Mints the JWT bearer tokens the tests authenticate with, signed with the host's key. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!--
      The adoption flow's broker leg is exercised over a real RabbitMQ, not a stubbed publisher:
      the acceptance criterion this suite gates is that an event bearing another tenant's id
      cannot mutate that tenant's animal, and an in-process fake would prove nothing about what
      the consumers actually do with a message that arrives off the wire.
    -->
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShelterStack.Animals.Api\ShelterStack.Animals.Api.csproj" />
    <!--
      The auth-pipeline isolation test logs in against the real Identity API to obtain a genuine
      JWT, so it needs that host too. Aliased as "identity" because both API assemblies expose a
      global Program type; the alias keeps the Animals-only M0 test's WebApplicationFactory<Program>
      unambiguous while the new test reaches Identity's host via identity::Program.
    -->
    <ProjectReference
      Include="..\..\src\ShelterStack.Identity.Api\ShelterStack.Identity.Api.csproj"
      Aliases="identity"
    />
    <!--
      The adoption isolation tests boot this host alongside the Animals one and drive the real
      approve → AdoptionApproved → AnimalStatusChangeRejected round trip between them. Aliased
      for the same reason as Identity: all three API assemblies expose a global Program type.
    -->
    <ProjectReference
      Include="..\..\src\ShelterStack.Adoptions.Api\ShelterStack.Adoptions.Api.csproj"
      Aliases="adoptions"
    />
  </ItemGroup>
</Project>
